# Base URL for the public API (JSONPlaceholder by default)
VITE_API_BASE=https://jsonplaceholder.typicode.com

# Toggle mock mode. When "true", the MSW service worker is loaded
# and intercepts requests. When anything else, MSW is tree-shaken
# out of the bundle (dynamic import).
VITE_ENABLE_MOCKING=false

# Hybrid mode: comma-separated MockRouteKey values to pass through
# to the real API instead of being mocked. Example:
# VITE_MSW_OMIT_KEYS=GET_USERS,CREATE_USER
# VITE_MSW_OMIT_KEYS=
